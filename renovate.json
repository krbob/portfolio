{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>krbob/renovate-config:monthly"
  ],
  "packageRules": [
    {
      "description": "Keep Kotlin compiler plugins and Ktor plugin and libraries compatible",
      "matchManagers": [
        "gradle"
      ],
      "matchDepNames": [
        "org.jetbrains.kotlin.jvm",
        "org.jetbrains.kotlin.plugin.serialization",
        "io.ktor.plugin",
        "io.ktor:ktor-*"
      ],
      "groupName": "Kotlin and Ktor"
    },
    {
      "description": "Hold TypeScript below 7 until the linting toolchain supports it",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Hold js-yaml below 5 until its breaking changes are adopted",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "js-yaml"
      ],
      "allowedVersions": "<5.0.0"
    },
    {
      "description": "Group non-major frontend runtime dependency updates",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "groupName": "Frontend runtime dependencies"
    },
    {
      "description": "Group non-major TypeScript type package updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "groupName": "TypeScript type packages"
    },
    {
      "description": "Group non-major frontend build tooling updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript",
        "vite",
        "@vitejs/plugin-react",
        "tailwindcss",
        "@tailwindcss/vite",
        "openapi-typescript"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "groupName": "Frontend build tooling"
    },
    {
      "description": "Group non-major frontend test tooling updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@playwright/test",
        "@testing-library/**",
        "jsdom",
        "vitest",
        "@vitest/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "groupName": "Frontend test tooling"
    },
    {
      "description": "Group non-major frontend linting updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "globals",
        "typescript-eslint"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "groupName": "Frontend linting"
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group non-major Docker image updates",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "groupName": "Docker images"
    },
    {
      "description": "Keep the API runtime on Java 21 until a coordinated toolchain upgrade",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "eclipse-temurin"
      ],
      "allowedVersions": "/^21\\./"
    },
    {
      "description": "Keep Node.js declarations and the web build image aligned",
      "matchDepNames": [
        "node"
      ],
      "groupName": "Node.js toolchain"
    },
    {
      "description": "Keep the Gradle wrapper and API build image aligned",
      "matchDepNames": [
        "gradle"
      ],
      "groupName": "Gradle toolchain"
    }
  ]
}
